* text=auto
*.py text eol=lf
*.cs text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf

# Art assets use Git LFS; install it before cloning/opening Unity.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.Fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
voices/**/*.wav filter=lfs diff=lfs merge=lfs -text
voices/**/*.m4a filter=lfs diff=lfs merge=lfs -text

# Preserve complete original model packs, including embedded glTF and source formats.
man/** filter=lfs diff=lfs merge=lfs -text
jumper_man/** filter=lfs diff=lfs merge=lfs -text
Characters_with_expressions/** filter=lfs diff=lfs merge=lfs -text
